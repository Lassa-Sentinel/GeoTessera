  progress = TRUE
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{region}}{Bounding box or sf object}

\item{\code{year}}{Integer year}

\item{\code{sample_rate}}{Fraction of pixels to sample (0-1). Use lower values
for very large regions. Default 1.0.}

\item{\code{mask_to_region}}{If TRUE and region is sf, only include pixels
inside the polygon. Default TRUE.}

\item{\code{seed}}{Random seed for reproducible sampling}

\item{\code{progress}}{Show progress. Default TRUE.}
}
\if{html}{\out{</div>}}
}
